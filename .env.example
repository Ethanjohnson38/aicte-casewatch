# Copy this file to .env and fill in your real local credentials.
# .env is git-ignored and must never be committed.

# Local PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for a default local install (replace PASSWORD with your own):
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/aicte_casewatch?schema=public"

# ---------- AICTE Voice: visual evidence (all optional; sensible defaults shown) ----------
# Upload limits
# EVIDENCE_MAX_FILES=5
# EVIDENCE_MAX_MB=10
# EVIDENCE_MAX_DIMENSION=6000

# Face blur tuning
# EVIDENCE_FACE_SCORE=0.4         # detection confidence threshold (0-1)
# EVIDENCE_FACE_PADDING=0.35      # expand each blurred box by this fraction

# Sensitive-content screening
# EVIDENCE_EXPLICIT_THRESHOLD=0.6 # nsfwjs Porn+Hentai+Sexy sum to flag as explicit
# Graphic/violence policy when no local violence model exists:
#   manual (default) = non-explicit images are hidden pending officer review (safe)
#   off              = operator accepts NO graphic screening; non-explicit shown
# EVIDENCE_GRAPHIC_POLICY=manual
# Optional external moderation provider endpoint (leave unset = unavailable)
# EVIDENCE_VIOLENCE_PROVIDER=

# Storage + models (defaults are ./storage/evidence and ./models)
# EVIDENCE_DIR=
# EVIDENCE_MODELS_DIR=

# Retention: abandoned draft uploads older than this are purged by the cleanup script
# EVIDENCE_DRAFT_TTL_HOURS=24
