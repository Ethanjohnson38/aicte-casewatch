# Copy this file to .env and fill in your real local credentials.
# .env is git-ignored and must never be committed.

# Local PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for a default local install (replace PASSWORD with your own):
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/aicte_casewatch?schema=public"
