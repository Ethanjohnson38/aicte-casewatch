// AICTE CaseWatch — Prisma schema
// Local PostgreSQL only. The browser never connects to the DB directly;
// all access is server-side through Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  COMMUNITY_MEMBER
  OFFICER
  ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  ASSIGNED
  IN_REVIEW
  RESOLVED
  REOPENED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Timeline entry types for a complaint (status/assignment changes, notes, etc).
enum ComplaintEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  INTERNAL_NOTE // staff-only; never shown to the submitter or public
  RESOLVED
  REOPENED
  LINKED_FROM_POST
  TRANSFERRED // ownership moved between Bureaus/Cells
  NEXT_ACTION // next required action / deadline set
  RELATED_DECISION // a related/duplicate link was confirmed or dismissed
  OUTCOME_RECORDED // a finding/outcome was recorded
  EVIDENCE_ADDED // a case evidence file was attached
  EVIDENCE_REVIEWED // case evidence review status/note changed
}

// Reviewer disposition for an official-complaint evidence file.
enum CaseEvidenceStatus {
  RECEIVED // logged, not yet reviewed
  REVIEWED // examined and accepted
  NEEDS_CLARIFICATION // reviewer needs more information
}

// Which party a case is currently waiting on (orthogonal to status).
enum AwaitingParty {
  NONE
  INSTITUTION // awaiting the institution's response
  BUREAU // blocked on another Bureau/Cell
  REVIEWER // awaiting expert/committee review
}

// Nature of a link between two complaints.
enum CaseRelationType {
  RELATED // related but distinct cases
  DUPLICATE // the same underlying case
}

// Officer disposition of a related/duplicate link.
enum RelationStatus {
  SUGGESTED // rule-based suggestion, not yet decided
  CONFIRMED // an officer confirmed the relationship
  DISMISSED // an officer judged it a false match
}

// Moderation state of an AICTE Voice post.
enum PostStatus {
  PUBLISHED
  FLAGGED
  HIDDEN
  REMOVED
}

// Officer disposition of an AI review-queue item.
enum ReviewStatus {
  PENDING
  NEEDS_REVIEW
  LINKED
  CONVERTED
  DISMISSED
}

// Face-detection + blurring status for an evidence image.
enum EvidenceFaceStatus {
  PENDING // not processed yet
  PROCESSED // faces detected and blurred
  NO_FACES // ran successfully, no faces found
  FAILED // detection/blur errored or timed out — needs retry/review, never published silently
}

// Sensitive-content screening status for an evidence image.
enum EvidenceScreenStatus {
  PENDING // not screened yet
  CLEAR // screened, below thresholds
  FLAGGED // auto-flagged sensitive (e.g. explicit) — hidden by default
  REVIEW_REQUIRED // classifier unavailable/uncertain (e.g. violence) — fail safe to hidden + manual review
  ERROR // screening errored — fail safe to hidden
}

// Manual reviewer disposition for flagged/needs-review evidence.
enum EvidenceReviewStatus {
  NONE // no manual review needed/taken
  PENDING // awaiting a reviewer
  CLEARED // reviewer judged it safe to unhide
  CONFIRMED_SENSITIVE // reviewer confirmed it stays hidden by default
}

// ---------- Identity & sessions ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // Public, pseudonymous handle shown in AICTE Voice. Never link to email publicly.
  pseudonym    String   @unique
  // Server-controlled only. Registration always creates COMMUNITY_MEMBER;
  // users can never set or elevate their own role.
  role         Role     @default(COMMUNITY_MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions             Session[]
  submittedComplaints  Complaint[]         @relation("Submitter")
  assignedComplaints   Complaint[]         @relation("AssignedOfficer")
  complaintEvents      ComplaintEvent[]    @relation("EventActor")
  posts                Post[]
  comments             Comment[]
  votes                Vote[]
  reviewedItems        ReviewQueueItem[]   @relation("Reviewer")
  createdLinks         PostComplaintLink[] @relation("LinkCreator")
  auditLogs            AuditLog[]          @relation("AuditActor")
  reports              Report[]            @relation("Reporter")
  uploadedEvidence     Evidence[]          @relation("EvidenceUploader")
  reviewedEvidence     Evidence[]          @relation("EvidenceReviewer")
  caseTransfers        CaseTransfer[]      @relation("TransferActor")
  createdRelations     CaseRelation[]      @relation("RelationCreator")
  decidedRelations     CaseRelation[]      @relation("RelationDecider")
  uploadedCaseEvidence ComplaintEvidence[] @relation("CaseEvidenceUploader")
  reviewedCaseEvidence ComplaintEvidence[] @relation("CaseEvidenceReviewer")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Reference data ----------

model Institution {
  id        String   @id @default(cuid())
  name      String   @unique
  // Optional consolidated-profile attributes (demo data; nullable so existing rows are valid).
  state     String?
  city      String?
  type      String? // e.g. "Engineering College", "Polytechnic"
  createdAt DateTime @default(now())

  complaints Complaint[]
  posts      Post[]

  @@index([state])
}

model Category {
  id         String      @id @default(cuid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  complaints Complaint[]
  posts      Post[]
}

// ---------- A. Official Complaints ----------

model Complaint {
  id           String          @id @default(cuid())
  trackingCode String          @unique
  title        String
  description  String
  status       ComplaintStatus @default(SUBMITTED)
  priority     Priority        @default(MEDIUM)

  submitterId       String
  submitter         User        @relation("Submitter", fields: [submitterId], references: [id])
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id])
  categoryId        String
  category          Category    @relation(fields: [categoryId], references: [id])
  assignedOfficerId String?
  assignedOfficer   User?       @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])

  // Current responsible Bureau/Cell (the single primary owner). Null = unassigned unit.
  currentBureauId String?
  currentBureau   Bureau? @relation("CurrentBureau", fields: [currentBureauId], references: [id])

  // Coordination/lifecycle fields (Features C/E/F). All optional/defaulted so the
  // migration is additive and existing rows stay valid.
  awaitingParty   AwaitingParty @default(NONE)
  nextAction      String?
  nextActionDueAt DateTime?
  deadlineBasis   String? // human-readable label of the configured rule used
  outcome         String? // recorded finding/outcome (shown once resolved)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       ComplaintEvent[]
  links        PostComplaintLink[]
  transfers    CaseTransfer[]
  relatedA     CaseRelation[]      @relation("RelatedA")
  relatedB     CaseRelation[]      @relation("RelatedB")
  caseEvidence ComplaintEvidence[]

  @@index([status])
  @@index([priority])
  @@index([institutionId])
  @@index([categoryId])
  @@index([assignedOfficerId])
  @@index([currentBureauId])
  @@index([awaitingParty])
  @@index([nextActionDueAt])
}

// ---------- Cross-Bureau coordination ----------

// A Bureau or Cell that can own/handle official complaints.
model Bureau {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique // short identifier, e.g. "PGRC"
  description String?
  createdAt   DateTime @default(now())

  complaints    Complaint[]    @relation("CurrentBureau")
  transfersFrom CaseTransfer[] @relation("TransferFrom")
  transfersTo   CaseTransfer[] @relation("TransferTo")
}

// Append-only ownership-transfer history. The current owner lives on Complaint;
// this table preserves every hand-off (who, when, why, from→to).
model CaseTransfer {
  id           String    @id @default(cuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromBureauId String?
  fromBureau   Bureau?   @relation("TransferFrom", fields: [fromBureauId], references: [id])
  toBureauId   String
  toBureau     Bureau    @relation("TransferTo", fields: [toBureauId], references: [id])
  reason       String // mandatory — never a silent transfer
  actorId      String
  actor        User      @relation("TransferActor", fields: [actorId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([complaintId])
  @@index([toBureauId])
}

// A confirmed/suggested/dismissed link between two complaints. The pair is stored
// in a canonical order (aId < bId) and is unique, preventing duplicate links.
// Linking never merges or deletes either case — both records are preserved.
model CaseRelation {
  id         String           @id @default(cuid())
  aId        String
  aComplaint Complaint        @relation("RelatedA", fields: [aId], references: [id], onDelete: Cascade)
  bId        String
  bComplaint Complaint        @relation("RelatedB", fields: [bId], references: [id], onDelete: Cascade)
  type       CaseRelationType @default(RELATED)
  status     RelationStatus   @default(SUGGESTED)
  reason     String?
  score      Int? // rule-based match score at decision time (0-100)

  createdById String
  createdBy   User      @relation("RelationCreator", fields: [createdById], references: [id])
  decidedById String?
  decidedBy   User?     @relation("RelationDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
  @@index([status])
}

// Secure evidence file attached to an OFFICIAL complaint (Feature G).
// Distinct from Voice `Evidence`: officer-facing case evidence is NOT face-blurred
// or screened, supports documents (PDF), and is served only via an authed route to
// staff or the complaint's submitter. Access is recorded in the AuditLog.
model ComplaintEvidence {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User   @relation("CaseEvidenceUploader", fields: [uploaderId], references: [id])

  // Random name in the private store (not a capability — every request is authorized).
  storedName   String @unique
  originalName String
  mimeType     String
  byteSize     Int

  source      String? // e.g. "Institution's written reply", "Site inspection photo"
  submittedAt DateTime? // when the evidence was submitted/received (officer-set)

  status     CaseEvidenceStatus @default(RECEIVED)
  reviewerId String?
  reviewer   User?              @relation("CaseEvidenceReviewer", fields: [reviewerId], references: [id])
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())

  @@index([complaintId])
  @@index([uploaderId])
}

model ComplaintEvent {
  id          String             @id @default(cuid())
  complaintId String
  complaint   Complaint          @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  type        ComplaintEventType
  // Human-readable summary of the change (e.g. "SUBMITTED -> ASSIGNED").
  detail      String?
  reason      String?
  actorId     String
  actor       User               @relation("EventActor", fields: [actorId], references: [id])
  createdAt   DateTime           @default(now())

  @@index([complaintId])
  @@index([actorId])
}

// ---------- B. AICTE Voice ----------

model Post {
  id            String       @id @default(cuid())
  authorId      String
  // authorId is the PRIVATE identity mapping — never expose it publicly.
  author        User         @relation(fields: [authorId], references: [id])
  title         String
  body          String
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  status        PostStatus   @default(PUBLISHED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  comments   Comment[]
  votes      Vote[]
  reviewItem ReviewQueueItem?
  links      PostComplaintLink[]
  reports    Report[]
  evidence   Evidence[]

  @@index([institutionId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

// Privacy-protected visual evidence attached to an AICTE Voice post.
// The ORIGINAL image is never retained: it is face-blurred in memory and only
// the protected rendition is stored, in a private dir served via an authed route.
model Evidence {
  id String @id @default(cuid())

  // Null while a draft upload is being reviewed; set when the uploader publishes.
  // Abandoned drafts (null postId) are removed by the retention/cleanup script.
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User   @relation("EvidenceUploader", fields: [uploaderId], references: [id])

  // Filename of the protected image in the private store (random; not guessable).
  // Access is still authorized per-request — the name is not a capability.
  storedName String @unique
  mimeType   String // always image/webp after safe re-encode
  byteSize   Int
  width      Int
  height     Int

  faceCount  Int                @default(0)
  faceStatus EvidenceFaceStatus @default(PENDING)

  screenStatus   EvidenceScreenStatus @default(PENDING)
  screenCategory String? // e.g. "EXPLICIT", "VIOLENCE_MANUAL"
  screenScore    Float?

  // sensitive = show the "potentially disturbing" overlay, hidden by default.
  sensitive Boolean @default(false)

  // Only published evidence is ever displayed; blocks display of unprocessed uploads.
  published Boolean @default(false)

  reviewStatus EvidenceReviewStatus @default(NONE)
  reviewedById String?
  reviewedBy   User?                @relation("EvidenceReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([uploaderId])
  @@index([screenStatus])
  @@index([published])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model Vote {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restricted to +1 or -1 by a CHECK constraint added in the init migration.
  value     Int
  createdAt DateTime @default(now())

  // One vote per authenticated user per post.
  @@unique([userId, postId])
  @@index([postId])
}

model Report {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id])
  reason     String
  createdAt  DateTime @default(now())

  // One report per user per post.
  @@unique([postId, reporterId])
  @@index([postId])
}

// ---------- C. AI-assisted review ----------

model ReviewQueueItem {
  id               String       @id @default(cuid())
  // One active review item per post (prevents duplicate queueing).
  postId           String       @unique
  post             Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  score            Int // 0-100 rule-based match score
  assessment       String? // short label, e.g. "Likely related"
  explanation      String // human-readable matching reasons
  suggestedMatches Json? // [{ complaintId, score, reasons }]
  status           ReviewStatus @default(PENDING)
  reviewedById     String?
  reviewedBy       User?        @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([score])
}

model PostComplaintLink {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("LinkCreator", fields: [createdById], references: [id])
  note        String?
  createdAt   DateTime  @default(now())

  // Prevents duplicate links between the same post and complaint.
  @@unique([postId, complaintId])
  @@index([complaintId])
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String // e.g. "COMPLAINT_ASSIGNED", "POST_LINKED"
  entityType String // e.g. "Complaint", "Post"
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}
